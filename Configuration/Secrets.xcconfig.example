// Copy this file to Configuration/Secrets.xcconfig and fill in the values from
// your free Google Cloud iOS OAuth client.
//
// Example reversed client ID format:
// com.googleusercontent.apps.1234567890-abcdefg

GOOGLE_SIGN_IN_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_SIGN_IN_REVERSED_CLIENT_ID = com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID
GOOGLE_SIGN_IN_SERVER_CLIENT_ID =
