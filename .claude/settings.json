{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/sync-xcode-project.sh",
            "timeout": 30,
            "statusMessage": "Syncing Xcode project..."
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/lint-swift.sh",
            "timeout": 15,
            "statusMessage": "Running SwiftLint..."
          }
        ]
      }
    ]
  }
}
